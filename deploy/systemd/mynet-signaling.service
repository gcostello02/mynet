[Unit]
Description=MyNet signaling client (login --stay)
After=network-online.target mynet-server.service

[Service]
Type=simple
User=mynet
Group=mynet
WorkingDirectory=/opt/mynet
EnvironmentFile=/opt/mynet/env.sh
ExecStart=/opt/mynet/mynet login --stay
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
