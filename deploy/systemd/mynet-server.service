[Unit]
Description=MyNet coordination server
After=network-online.target

[Service]
Type=simple
User=mynet
Group=mynet
WorkingDirectory=/opt/mynet
EnvironmentFile=/opt/mynet/env.sh
ExecStart=/opt/mynet/mynet-server --listen :8787 --data /var/lib/mynet/devices.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
