# Copy to .env and fill before first start. Do not commit .env.

# Required: at least 32 random bytes (openssl rand -base64 32)
MYNET_SERVER_SECRET=

# Persistent coordinator state (SQLite + Ed25519 identity key)
MYNET_DATA_PATH=/data/coordinator.db

# Public HTTPS URL clients use (set during setup wizard; shown here for reference)
# MYNET_PUBLIC_URL=https://coordinator.example.com

# Set true when serving the dashboard over HTTPS
MYNET_SECURE_COOKIES=true

# Optional: legacy static setup token for automation (prefer one-time bootstrap capability)
# MYNET_SETUP_TOKEN=

# VPN addressing for enrolled devices
MYNET_VPN_CIDR=172.31.240.0/20

# ICE / NAT traversal (optional)
# MYNET_STUN_URLS=stun:stun.l.google.com:19302
# MYNET_TURN_URLS=turn:turn.example.com:3478
# MYNET_TURN_SECRET=

# Listen address inside the container
MYNET_LISTEN=:8080
